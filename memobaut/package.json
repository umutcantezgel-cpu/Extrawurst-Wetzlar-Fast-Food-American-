{
  "name": "memobaut-website",
  "version": "1.0.0",
  "description": "Premium Static Website für memobaut.com - Bauunternehmen",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --ext .ts,.astro",
    "format": "prettier --write \"**/*.{astro,ts,css,json}\"",
    "contracts:validate": "node scripts/validate-contracts.js",
    "sri:gen": "node scripts/gen-sri.js",
    "sri:verify": "node scripts/verify-sri.js",
    "images:optimize": "node scripts/optimize-images.js",
    "lhci": "lhci autorun",
    "a11y": "pa11y-ci",
    "test": "npm run typecheck && npm run contracts:validate && npm run lint"
  },
  "dependencies": {
    "@astrojs/netlify": "^5.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/tailwind": "^5.0.0",
    "astro": "^4.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-astro": "^0.31.0",
    "pa11y-ci": "^3.1.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.12.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "sharp": "^0.33.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/[USERNAME]/memobaut-website.git"
  },
  "keywords": [
    "bauunternehmen",
    "construction",
    "astro",
    "static-site",
    "wcag",
    "performance"
  ],
  "author": "memobaut Team",
  "license": "PROPRIETARY"
}
