---
/**
 * 404 Error Page - memobaut.com
 * Statische Fehlerseite ohne externe Abhängigkeiten
 * WCAG 2.2 AA konform
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const pageTitle = '404 - Seite nicht gefunden | memobaut';
const pageDescription = 'Die angeforderte Seite konnte nicht gefunden werden. Kehren Sie zur Startseite zurück oder nutzen Sie die Navigation.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  robots="noindex, nofollow"
>
  <div class="error-page">
    <div class="container">
      <div class="error-page__content">
        <!-- Error Code -->
        <div class="error-page__code" aria-hidden="true">404</div>

        <!-- Heading -->
        <h1 class="error-page__title">
          Seite nicht gefunden
        </h1>

        <!-- Description -->
        <p class="error-page__description">
          Die angeforderte Seite existiert leider nicht oder wurde verschoben.
          Bitte überprüfen Sie die URL oder kehren Sie zur Startseite zurück.
        </p>

        <!-- Actions -->
        <div class="error-page__actions">
          <Button
            href="/"
            variant="primary"
            size="lg"
            ariaLabel="Zurück zur Startseite"
          >
            Zur Startseite
          </Button>

          <Button
            href="/kontakt/"
            variant="secondary"
            size="lg"
            ariaLabel="Kontakt aufnehmen"
          >
            Kontakt
          </Button>
        </div>

        <!-- Helpful Links -->
        <nav class="error-page__links" aria-label="Hilfreiche Links">
          <h2 class="error-page__links-title">Vielleicht suchen Sie:</h2>
          <ul>
            <li><a href="/leistungen/">Unsere Leistungen</a></li>
            <li><a href="/referenzen/">Referenzen</a></li>
            <li><a href="/ueber-uns/">Über uns</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-12) 0;
    position: relative;
    z-index: var(--z-base);
  }

  .error-page__content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .error-page__code {
    font-size: clamp(6rem, 10vw, 10rem);
    font-weight: var(--font-weight-black);
    line-height: 1;
    color: var(--brand-primary-200);
    opacity: 0.3;
    margin-bottom: var(--spacing-6);
    font-family: var(--font-family-serif);
    user-select: none;
  }

  .error-page__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-4);
  }

  .error-page__description {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-8);
  }

  .error-page__actions {
    display: flex;
    gap: var(--spacing-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-10);
  }

  .error-page__links {
    margin-top: var(--spacing-10);
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--border-subtle);
  }

  .error-page__links-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-4);
  }

  .error-page__links ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--spacing-6);
    justify-content: center;
    flex-wrap: wrap;
  }

  .error-page__links a {
    color: var(--text-link);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    transition: color var(--transition-fast) var(--easing-out);
  }

  .error-page__links a:hover {
    color: var(--text-link-hover);
  }

  .error-page__links a:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset-width);
    border-radius: var(--radius-sm);
  }

  /* Dark mode */
  @media (prefers-color-scheme: dark) {
    .error-page__code {
      color: var(--brand-primary-800);
    }
  }
</style>
