---
/**
 * Kontakt Page - memobaut.com
 * SEO data from: contracts/routes/seo.routes.json
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import ContactForm from '../../components/ContactForm.astro';
import Card from '../../components/Card.astro';

const seo = {
  title: 'Kontakt - Jetzt Projekt anfragen | memobaut',
  description: 'Kontaktieren Sie uns für eine unverbindliche Beratung. Wir freuen uns auf Ihr Bauvorhaben!',
  ogTitle: 'Kontaktieren Sie memobaut',
  ogDescription: 'Wir sind für Sie da - persönlich, telefonisch oder per E-Mail.',
  ogImage: '/assets/images/og-kontakt.jpg',
  structuredData: {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Kontakt zu memobaut',
  },
};
---

<BaseLayout {...seo}>
  <Navigation slot="header" />

  <Hero
    variant="minimal"
    title="Kontakt"
    subtitle="Wir freuen uns auf Ihre Anfrage"
  />

  <!-- Contact Section -->
  <section class="contact">
    <div class="container">
      <div class="contact__grid">
        <!-- Contact Form -->
        <div class="contact__form-wrapper">
          <h2 class="contact__title">Nachricht senden</h2>
          <p class="contact__description">
            Beschreiben Sie uns Ihr Bauvorhaben. Wir melden uns zeitnah bei Ihnen zurück.
          </p>
          <ContactForm />
        </div>

        <!-- Contact Info -->
        <div class="contact__info-wrapper">
          <Card variant="glass" padding="xl">
            <div class="contact-info">
              <h2 class="contact-info__title">Kontaktinformationen</h2>

              <div class="contact-info__section">
                <h3 class="contact-info__subtitle">Adresse</h3>
                <p class="contact-info__text">
                  [Adresse wird ergänzt]<br />
                  [PLZ Ort wird ergänzt]<br />
                  Deutschland
                </p>
              </div>

              <div class="contact-info__section">
                <h3 class="contact-info__subtitle">Telefon</h3>
                <p class="contact-info__text">
                  <a href="tel:[TO BE PROVIDED]" class="contact-info__link">
                    [Telefonnummer wird ergänzt]
                  </a>
                </p>
              </div>

              <div class="contact-info__section">
                <h3 class="contact-info__subtitle">E-Mail</h3>
                <p class="contact-info__text">
                  <a href="mailto:info@memobaut.com" class="contact-info__link">
                    info@memobaut.com
                  </a>
                </p>
              </div>

              <div class="contact-info__section">
                <h3 class="contact-info__subtitle">Öffnungszeiten</h3>
                <p class="contact-info__text">
                  Montag - Freitag: 08:00 - 17:00 Uhr<br />
                  Samstag: Nach Vereinbarung<br />
                  Sonntag: Geschlossen
                </p>
              </div>

              <div class="contact-info__note">
                <p>
                  <strong>Hinweis:</strong> Für dringende Anfragen erreichen Sie uns telefonisch. Wir rufen Sie auch gerne zurück.
                </p>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact {
    padding-top: var(--section-padding-md);
    padding-bottom: var(--section-padding-lg);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--section-padding-md);
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .contact__form-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .contact__title {
    font-size: var(--font-size-3xl);
  }

  .contact__description {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Contact Info */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .contact-info__title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-4);
  }

  .contact-info__section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .contact-info__subtitle {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-info__text {
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--text-secondary);
  }

  .contact-info__link {
    color: var(--text-link);
    text-decoration: none;
    transition: color var(--transition-micro) var(--easing-out);
  }

  .contact-info__link:hover {
    color: var(--text-link-hover);
    text-decoration: underline;
  }

  .contact-info__note {
    padding: var(--spacing-4);
    background-color: var(--bg-brand-light);
    border-left: 4px solid var(--border-brand);
    border-radius: var(--radius-interactive);
  }

  .contact-info__note p {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--text-primary);
  }
</style>
