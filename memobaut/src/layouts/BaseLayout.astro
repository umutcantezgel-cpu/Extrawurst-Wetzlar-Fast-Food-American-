---
/**
 * BaseLayout - memobaut.com
 * Main layout component with SEO, accessibility, and security features
 */

import '../styles/global.css';
import AnimatedBackground from '../components/AnimatedBackground.astro';

export interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  canonical?: string;
  structuredData?: object;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/assets/images/og-default.jpg',
  ogType = 'website',
  robots = 'index, follow',
  canonical,
  structuredData,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:site_name" content="memobaut" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    {ogDescription && <meta name="twitter:description" content={ogDescription} />}
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preconnect to performance-critical origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Structured Data (Schema.org) -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Security Headers (Content-Security-Policy handled by Netlify) -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#1E40AF" />

    <slot name="head" />
  </head>

  <body>
    <!-- Animated Background (Premium visual depth) -->
    <AnimatedBackground variant="subtle" />

    <!-- Skip to main content link (A11y) -->
    <a href="#main-content" class="skip-to-main">
      Zum Hauptinhalt springen
    </a>

    <!-- Navigation -->
    <slot name="header" />

    <!-- Main Content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <slot name="footer" />

    <!-- Analytics / Scripts -->
    <slot name="scripts" />

    <!-- Inline critical scripts (if needed) -->
    <script is:inline>
      // Update current year in footer
      document.addEventListener('DOMContentLoaded', () => {
        const yearElements = document.querySelectorAll('[data-current-year]');
        yearElements.forEach(el => {
          el.textContent = new Date().getFullYear();
        });
      });
    </script>

    <!-- Scroll-triggered animations -->
    <script>
      import { initScrollAnimations } from '../utils/scroll-animations';
      initScrollAnimations();
    </script>
  </body>
</html>

<style>
  body {
    position: relative;
  }

  /* Main element spacing and layering */
  main {
    min-height: 60vh;
    position: relative;
    z-index: var(--z-base);
  }

  /* Ensure focus is visible on main when skipping to content */
  main:focus {
    outline: none;
  }

  /* Ensure header/footer are above background */
  nav,
  footer {
    position: relative;
    z-index: var(--z-sticky);
  }
</style>
