---
/**
 * Footer Component - memobaut.com
 * Site footer with links, contact info, and legal
 * Contract: contracts/components/footer.contract.json
 */
---

<footer class="footer">
  <div class="footer__inner container">
    <!-- Main Footer Grid -->
    <div class="footer__grid">
      <!-- Company Section -->
      <div class="footer__section">
        <div class="footer__logo">memobaut</div>
        <p class="footer__description">
          Ihr zuverlässiger Partner für Neubau, Sanierung und Umbau.
        </p>
      </div>

      <!-- Services Section -->
      <div class="footer__section">
        <h3 class="footer__title">Leistungen</h3>
        <ul class="footer__links">
          <li>
            <a href="/leistungen/#neubau" class="footer__link">Neubau</a>
          </li>
          <li>
            <a href="/leistungen/#sanierung" class="footer__link">Sanierung</a>
          </li>
          <li>
            <a href="/leistungen/#umbau" class="footer__link">Umbau</a>
          </li>
          <li>
            <a href="/leistungen/#beratung" class="footer__link">Beratung</a>
          </li>
        </ul>
      </div>

      <!-- Company Info Section -->
      <div class="footer__section">
        <h3 class="footer__title">Unternehmen</h3>
        <ul class="footer__links">
          <li>
            <a href="/ueber-uns/" class="footer__link">Über uns</a>
          </li>
          <li>
            <a href="/referenzen/" class="footer__link">Referenzen</a>
          </li>
          <li>
            <a href="/karriere/" class="footer__link">Karriere</a>
          </li>
        </ul>
      </div>

      <!-- Contact Section -->
      <div class="footer__section">
        <h3 class="footer__title">Kontakt</h3>
        <ul class="footer__contact">
          <li class="footer__contact-item">
            <svg class="footer__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 1C5.23858 1 3 3.23858 3 6C3 9.5 8 15 8 15C8 15 13 9.5 13 6C13 3.23858 10.7614 1 8 1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span>[Adresse wird ergänzt]</span>
          </li>
          <li class="footer__contact-item">
            <svg class="footer__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M14.5 11.3V13.3C14.5001 13.4657 14.4655 13.6296 14.3985 13.7808C14.3314 13.932 14.2334 14.067 14.111 14.1769C13.9886 14.2868 13.8445 14.3691 13.6884 14.4181C13.5323 14.4672 13.3677 14.4819 13.2056 14.4614C11.1784 14.2127 9.23668 13.4708 7.54 12.2994C5.9804 11.2489 4.66572 9.85008 3.69 8.20002C2.49998 6.4677 1.75036 4.48433 1.50667 2.41336C1.48622 2.25217 1.50084 2.08858 1.54948 1.93334C1.59812 1.7781 1.67974 1.63475 1.78869 1.51283C1.89765 1.39091 2.03164 1.29309 2.18158 1.22585C2.33152 1.15861 2.49407 1.12341 2.65833 1.12336H4.65833C4.94542 1.12051 5.22339 1.22156 5.4396 1.40969C5.6558 1.59782 5.79536 1.85999 5.83167 2.14502C5.89876 2.71496 6.02945 3.27561 6.22167 3.81669C6.30132 4.04016 6.31403 4.28164 6.25821 4.51196C6.20239 4.74228 6.08042 4.95163 5.90667 5.11502L5.01667 6.00502C6.03196 7.64737 7.47098 9.08638 9.11333 10.1017L10.0033 9.21169C10.1667 9.03794 10.3761 8.91597 10.6064 8.86015C10.8367 8.80433 11.0782 8.81704 11.3017 8.89669C11.8427 9.08891 12.4034 9.2196 12.9733 9.28669C13.2624 9.32329 13.5278 9.46641 13.7163 9.68737C13.9049 9.90834 14.003 10.1918 14 10.4833V11.3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <a href="tel:[TO BE PROVIDED]" class="footer__link">[Telefon wird ergänzt]</a>
          </li>
          <li class="footer__contact-item">
            <svg class="footer__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2.66667 2.66669H13.3333C14.0667 2.66669 14.6667 3.26669 14.6667 4.00002V12C14.6667 12.7334 14.0667 13.3334 13.3333 13.3334H2.66667C1.93333 13.3334 1.33333 12.7334 1.33333 12V4.00002C1.33333 3.26669 1.93333 2.66669 2.66667 2.66669Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14.6667 4L8 8.66667L1.33333 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <a href="mailto:info@memobaut.com" class="footer__link">info@memobaut.com</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <p class="footer__copyright">
        © <span data-current-year>2025</span> memobaut. Alle Rechte vorbehalten.
      </p>
      <ul class="footer__legal">
        <li>
          <a href="/impressum/" class="footer__link">Impressum</a>
        </li>
        <li>
          <a href="/datenschutz/" class="footer__link">Datenschutz</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-inverse);
    color: var(--text-inverse);
    padding-top: var(--section-padding-lg);
    padding-bottom: var(--section-padding-md);
    border-top: 1px solid var(--neutral-800);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-padding-md);
  }

  /* Main Grid */
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-loose);
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer__section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  /* Logo */
  .footer__logo {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-inverse);
  }

  .footer__description {
    color: var(--neutral-300);
    line-height: var(--line-height-relaxed);
  }

  /* Titles */
  .footer__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-inverse);
    margin-bottom: 0;
  }

  /* Links */
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    list-style: none;
  }

  .footer__link {
    color: var(--neutral-300);
    text-decoration: none;
    transition: color var(--transition-micro) var(--easing-out);
  }

  .footer__link:hover {
    color: var(--neutral-100);
    text-decoration: underline;
  }

  .footer__link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
    color: var(--neutral-100);
  }

  /* Contact */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    list-style: none;
  }

  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2);
    color: var(--neutral-300);
  }

  .footer__icon {
    flex-shrink: 0;
    margin-top: var(--spacing-1);
  }

  /* Bottom Bar */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding-top: var(--section-padding-sm);
    border-top: 1px solid var(--neutral-800);
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer__copyright {
    color: var(--neutral-400);
    font-size: var(--font-size-sm);
  }

  .footer__legal {
    display: flex;
    gap: var(--spacing-6);
    list-style: none;
  }

  .footer__legal .footer__link {
    font-size: var(--font-size-sm);
  }
</style>
