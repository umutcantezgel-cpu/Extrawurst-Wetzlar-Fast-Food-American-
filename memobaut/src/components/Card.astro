---
/**
 * Card Component - memobaut.com
 * Reusable card container with glass/elevated variants
 * Contract: contracts/components/card.contract.json
 */

export interface Props {
  variant?: 'default' | 'glass' | 'elevated' | 'interactive';
  as?: 'div' | 'article' | 'section';
  href?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  hoverable?: boolean;
  class?: string;
}

const {
  variant = 'default',
  as: Tag = 'div',
  href,
  padding = 'xl',
  hoverable = false,
  class: className = '',
} = Astro.props;

const WrapperTag = href ? 'a' : Tag;

const baseClass = 'card';
const variantClass = `card--${variant}`;
const paddingClass = `card--padding-${padding}`;
const hoverableClass = hoverable || href ? 'card--hoverable' : '';

const classes = [
  baseClass,
  variantClass,
  paddingClass,
  hoverableClass,
  className,
].filter(Boolean).join(' ');
---

<WrapperTag class={classes} href={href}>
  <slot />
</WrapperTag>

<style>
  .card {
    /* Base styles */
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;

    /* Physics-based transitions */
    transition:
      box-shadow var(--transition-base) var(--easing-out),
      transform var(--transition-base) var(--easing-spring),
      border-color var(--transition-base) var(--easing-out);
  }

  /* Link card reset */
  a.card {
    text-decoration: none;
    color: inherit;
  }

  /* Focus styles - Using utility pattern */
  .card:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset-width);
  }

  /* Default variant */
  .card--default {
    background-color: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
  }

  .card--default.card--hoverable:hover {
    box-shadow: var(--shadow-xl);
    border-color: var(--border-default);
    transform: translateY(-2px);
  }

  /* Glass variant - Using new glassmorphism system */
  .card--glass {
    background: var(--glass-bg-medium);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--radius-card);
    box-shadow: var(--glass-shadow-md);
  }

  .card--glass.card--hoverable:hover {
    background: var(--glass-bg-strong);
    box-shadow: var(--shadow-lg);
    border-color: var(--glass-border-strong);
    transform: translateY(-2px);
  }

  /* Elevated variant */
  .card--elevated {
    background-color: var(--surface-raised);
    border: none;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
  }

  .card--elevated.card--hoverable:hover {
    box-shadow: var(--shadow-2xl);
    transform: translateY(-4px);
  }

  /* Interactive variant - Premium 3D effect */
  .card--interactive {
    background-color: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transform-style: preserve-3d;
  }

  .card--interactive:hover {
    box-shadow: var(--shadow-2xl);
    transform: translateY(-6px) scale(1.02);
    border-color: var(--border-brand);
  }

  /* Padding variants */
  .card--padding-none {
    padding: 0;
  }

  .card--padding-sm {
    padding: var(--spacing-4);
  }

  .card--padding-md {
    padding: var(--spacing-6);
  }

  .card--padding-lg {
    padding: var(--spacing-8);
  }

  .card--padding-xl {
    padding: var(--component-padding-xl);
  }

  /* Fallback für Browser ohne backdrop-filter */
  @supports not (backdrop-filter: blur(16px)) {
    .card--glass {
      background: var(--bg-primary);
      box-shadow: var(--shadow-lg);
    }
  }
</style>
