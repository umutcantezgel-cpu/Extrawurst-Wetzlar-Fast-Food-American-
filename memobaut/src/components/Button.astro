---
/**
 * Button Component - memobaut.com
 * Accessible, reusable button with variants and sizes
 * Contract: contracts/components/button.contract.json
 */

export interface Props {
  variant?: 'primary' | 'secondary' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  ariaLabel,
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'button';
const baseClass = 'btn';
const variantClass = `btn--${variant}`;
const sizeClass = `btn--${size}`;
const fullWidthClass = fullWidth ? 'btn--full' : '';
const disabledClass = disabled ? 'btn--disabled' : '';

const classes = [
  baseClass,
  variantClass,
  sizeClass,
  fullWidthClass,
  disabledClass,
  className,
].filter(Boolean).join(' ');
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  disabled={disabled && !href ? true : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  aria-label={ariaLabel}
  tabindex={disabled ? -1 : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    /* Base styles */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    position: relative;
    overflow: hidden;

    /* Physics-based transitions */
    transition:
      background-color var(--transition-base) var(--easing-spring),
      box-shadow var(--transition-base) var(--easing-out),
      transform var(--transition-base) var(--easing-spring),
      border-color var(--transition-base) var(--easing-out);

    /* Reset */
    border: none;
    outline: none;
  }

  /* Focus styles (WCAG 2.4.7) - Using utility class pattern */
  .btn:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset-width);
  }

  /* Size variants */
  .btn--sm {
    font-size: var(--font-size-sm);
    padding: var(--spacing-2) var(--spacing-4);
    min-height: 36px;
    border-radius: var(--radius-interactive);
  }

  .btn--md {
    font-size: var(--font-size-base);
    padding: var(--spacing-3) var(--spacing-6);
    min-height: 44px;
    border-radius: var(--radius-interactive);
  }

  .btn--lg {
    font-size: var(--font-size-lg);
    padding: var(--spacing-4) var(--spacing-8);
    min-height: 52px;
    border-radius: var(--radius-interactive);
  }

  /* Primary variant - Premium Solid */
  .btn--primary {
    background-color: var(--bg-brand);
    color: var(--text-inverse);
    border: 1px solid var(--brand-primary-600);
    box-shadow: var(--shadow-md);
  }

  .btn--primary:hover:not(.btn--disabled) {
    background-color: var(--brand-primary-600);
    box-shadow: var(--shadow-xl);
    transform: translateY(-2px) scale(1.02);
  }

  .btn--primary:active:not(.btn--disabled) {
    background-color: var(--brand-primary-700);
    box-shadow: var(--shadow-sm);
    transform: translateY(0) scale(0.98);
  }

  /* Secondary variant - Glassmorphism */
  .btn--secondary {
    background: var(--glass-bg-medium);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    color: var(--text-primary);
    border: 1px solid var(--glass-border-medium);
    box-shadow: var(--glass-shadow-md);
  }

  .btn--secondary:hover:not(.btn--disabled) {
    background: var(--glass-bg-strong);
    border-color: var(--glass-border-strong);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px) scale(1.02);
  }

  .btn--secondary:active:not(.btn--disabled) {
    background: var(--glass-bg-ultra-strong);
    transform: translateY(0) scale(0.98);
  }

  /* Accent variant - Premium Gradient */
  .btn--accent {
    background: linear-gradient(
      135deg,
      var(--brand-secondary-500) 0%,
      var(--brand-secondary-600) 100%
    );
    color: var(--text-inverse);
    border: 1px solid var(--brand-secondary-600);
    box-shadow: var(--shadow-md);
  }

  .btn--accent:hover:not(.btn--disabled) {
    background: linear-gradient(
      135deg,
      var(--brand-secondary-600) 0%,
      var(--brand-secondary-700) 100%
    );
    box-shadow: var(--shadow-xl);
    transform: translateY(-2px) scale(1.02);
  }

  .btn--accent:active:not(.btn--disabled) {
    background: var(--brand-secondary-700);
    box-shadow: var(--shadow-sm);
    transform: translateY(0) scale(0.98);
  }

  /* Full width */
  .btn--full {
    width: 100%;
  }

  /* Disabled state */
  .btn--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Fallback für Browser ohne backdrop-filter */
  @supports not (backdrop-filter: blur(16px)) {
    .btn--secondary {
      background: var(--bg-secondary);
      box-shadow: var(--shadow-lg);
    }
  }
</style>
