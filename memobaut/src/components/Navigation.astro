---
/**
 * Navigation Component - memobaut.com
 * Responsive navigation with mobile menu
 * Contract: contracts/components/navigation.contract.json
 */

const currentPath = Astro.url.pathname;

const menuItems = [
  { label: 'Home', href: '/', exact: true },
  { label: 'Leistungen', href: '/leistungen/', exact: false },
  { label: 'Referenzen', href: '/referenzen/', exact: false },
  { label: 'Über uns', href: '/ueber-uns/', exact: false },
  { label: 'Kontakt', href: '/kontakt/', exact: false, highlight: true },
];

function isActive(itemPath: string, exact: boolean): boolean {
  if (exact) {
    return currentPath === itemPath;
  }
  return currentPath.startsWith(itemPath);
}
---

<nav class="nav" aria-label="Hauptnavigation">
  <div class="nav__inner container">
    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="memobaut - Zur Startseite">
      <span class="nav__logo-text">memobaut</span>
    </a>

    <!-- Desktop Menu -->
    <ul class="nav__menu" role="menubar">
      {menuItems.map((item) => (
        <li role="none">
          <a
            href={item.href}
            class:list={[
              'nav__link',
              { 'nav__link--active': isActive(item.href, item.exact) },
              { 'nav__link--highlight': item.highlight },
            ]}
            aria-current={isActive(item.href, item.exact) ? 'page' : undefined}
            role="menuitem"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile Menu Toggle -->
    <button
      class="nav__toggle"
      aria-label="Menü öffnen/schließen"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="nav__toggle-icon"></span>
    </button>
  </div>

  <!-- Mobile Menu Panel -->
  <div
    id="mobile-menu"
    class="nav__mobile"
    aria-hidden="true"
    data-mobile-menu
  >
    <ul class="nav__mobile-list" role="menu">
      {menuItems.map((item) => (
        <li role="none">
          <a
            href={item.href}
            class:list={[
              'nav__mobile-link',
              { 'nav__mobile-link--active': isActive(item.href, item.exact) },
            ]}
            aria-current={isActive(item.href, item.exact) ? 'page' : undefined}
            role="menuitem"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  // Mobile menu functionality
  const toggle = document.querySelector('[data-mobile-toggle]') as HTMLButtonElement;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement;
  const nav = document.querySelector('.nav') as HTMLElement;
  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    toggle.setAttribute('aria-expanded', isOpen.toString());
    menu.setAttribute('aria-hidden', (!isOpen).toString());
    document.body.style.overflow = isOpen ? 'hidden' : '';

    if (isOpen) {
      menu.classList.add('nav__mobile--open');
      // Focus first link
      const firstLink = menu.querySelector('a') as HTMLAnchorElement;
      firstLink?.focus();
    } else {
      menu.classList.remove('nav__mobile--open');
    }
  }

  toggle?.addEventListener('click', toggleMenu);

  // Close menu on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleMenu();
      toggle?.focus();
    }
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (isOpen && !nav.contains(e.target as Node)) {
      toggleMenu();
    }
  });

  // Sticky navigation with Intersection Observer (performance optimized)
  // Create a sentinel element at the top of the page
  const sentinel = document.createElement('div');
  sentinel.style.position = 'absolute';
  sentinel.style.top = '50px';
  sentinel.style.height = '1px';
  sentinel.style.width = '100%';
  document.body.prepend(sentinel);

  const observer = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) {
        nav.classList.remove('nav--scrolled');
      } else {
        nav.classList.add('nav--scrolled');
      }
    },
    { threshold: [0] }
  );

  observer.observe(sentinel);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    width: 100%;
    height: 80px;

    /* Glassmorphism 2.0 */
    background: var(--glass-bg-light);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border-bottom: 1px solid var(--glass-border-light);

    /* Physics-based transitions */
    transition:
      box-shadow var(--transition-base) var(--easing-out),
      background-color var(--transition-base) var(--easing-spring),
      border-color var(--transition-base) var(--easing-out);
  }

  .nav--scrolled {
    box-shadow: var(--shadow-lg);
    background: var(--glass-bg-medium);
    border-bottom-color: var(--glass-border-medium);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* Logo */
  .nav__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-xl);
    letter-spacing: var(--letter-spacing-tight);
    transition: color var(--transition-fast) var(--easing-out);
  }

  .nav__logo:hover {
    color: var(--text-link);
  }

  .nav__logo:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset-width);
    border-radius: var(--radius-interactive);
  }

  /* Desktop Menu */
  .nav__menu {
    display: none;
    list-style: none;
    gap: var(--gap-relaxed);
    align-items: center;
  }

  @media (min-width: 768px) {
    .nav__menu {
      display: flex;
    }
  }

  .nav__link {
    display: block;
    padding: var(--spacing-2) var(--spacing-3);
    color: var(--text-secondary);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-base);
    text-decoration: none;
    border-radius: var(--radius-interactive);
    transition: color var(--transition-micro) var(--easing-out);
  }

  .nav__link:hover {
    color: var(--text-link);
  }

  .nav__link--active {
    color: var(--text-link);
    font-weight: var(--font-weight-semibold);
    border-bottom: 2px solid var(--border-brand);
  }

  .nav__link--highlight {
    background-color: var(--bg-brand);
    color: var(--text-inverse);
    padding: var(--spacing-2) var(--spacing-4);
  }

  .nav__link--highlight:hover {
    background-color: var(--brand-primary-600);
    color: var(--text-inverse);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .nav__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset-width);
  }

  /* Mobile Toggle */
  .nav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .nav__toggle {
      display: none;
    }
  }

  .nav__toggle:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset-width);
    border-radius: var(--radius-interactive);
  }

  .nav__toggle-icon {
    position: relative;
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--text-primary);
    transition: background-color var(--transition-fast) var(--easing-out);
  }

  .nav__toggle-icon::before,
  .nav__toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 24px;
    height: 2px;
    background-color: var(--text-primary);
    transition: transform var(--transition-fast) var(--easing-out);
  }

  .nav__toggle-icon::before {
    top: -8px;
  }

  .nav__toggle-icon::after {
    bottom: -8px;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-icon {
    background-color: transparent;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-icon::before {
    transform: translateY(8px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-icon::after {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Mobile Menu */
  .nav__mobile {
    position: fixed;
    top: 80px;
    left: 0;
    right: 0;
    bottom: 0;

    /* Glassmorphism for mobile menu */
    background: var(--glass-bg-strong);
    backdrop-filter: blur(20px) saturate(190%);
    -webkit-backdrop-filter: blur(20px) saturate(190%);

    /* Smooth slide-in with spring easing */
    transform: translateX(100%);
    transition: transform var(--transition-slow) var(--easing-spring);
    overflow-y: auto;
    z-index: var(--z-dropdown);
  }

  .nav__mobile--open {
    transform: translateX(0);
  }

  @media (min-width: 768px) {
    .nav__mobile {
      display: none;
    }
  }

  .nav__mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    padding: var(--spacing-6);
    list-style: none;
  }

  .nav__mobile-link {
    display: block;
    padding: var(--spacing-4);
    color: var(--text-primary);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-radius: var(--radius-interactive);
    transition:
      background-color var(--transition-micro) var(--easing-out),
      color var(--transition-micro) var(--easing-out);
  }

  .nav__mobile-link:hover {
    background-color: var(--bg-brand-light);
    color: var(--text-link);
  }

  .nav__mobile-link--active {
    background-color: var(--bg-brand);
    color: var(--text-inverse);
    font-weight: var(--font-weight-semibold);
  }

  .nav__mobile-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: calc(var(--focus-ring-offset-width) * -1);
  }

  /* Fallback für Browser ohne backdrop-filter */
  @supports not (backdrop-filter: blur(12px)) {
    .nav {
      background: var(--bg-primary);
      box-shadow: var(--shadow-md);
    }

    .nav__mobile {
      background: var(--bg-primary);
    }
  }
</style>
