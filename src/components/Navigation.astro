---
/**
 * Navigation Component
 * WCAG 2.2 AA, Mobile-friendly, Keyboard accessible
 */

const navItems = [
  { label: 'Start', href: '/' },
  { label: 'Speisekarte', href: '/speisekarte/' },
  { label: 'Über uns', href: '/ueber-uns/' },
  { label: 'Kontakt', href: '/kontakt/' },
];

const currentPath = Astro.url.pathname;
---

<nav class="main-nav" aria-label="Hauptnavigation">
  <!-- Mobile Menu Button -->
  <button
    type="button"
    class="mobile-menu-button"
    aria-expanded="false"
    aria-controls="nav-menu"
    aria-label="Menü öffnen"
    data-nav-toggle
  >
    <svg
      class="menu-icon"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <svg
      class="close-icon hidden"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Navigation Menu -->
  <ul class="nav-menu" id="nav-menu" role="list">
    {navItems.map(({ label, href }) => {
      const isCurrent = currentPath === href || (href !== '/' && currentPath.startsWith(href));
      return (
        <li>
          <a
            href={href}
            class={isCurrent ? 'nav-link active' : 'nav-link'}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .main-nav {
    display: flex;
    align-items: center;
  }

  .mobile-menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--color-text-primary);
    border-radius: var(--radius-base);
    transition: background-color var(--transition-base) var(--ease-in-out);
  }

  .mobile-menu-button:hover {
    background-color: var(--color-bg-secondary);
  }

  .mobile-menu-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .close-icon,
  .menu-icon {
    transition: opacity var(--transition-base) var(--ease-in-out);
  }

  .nav-menu {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--space-4);
    background-color: var(--color-bg-primary);
    border-top: 1px solid var(--color-border-primary);
    list-style: none;
    transform: translateX(-100%);
    transition: transform var(--transition-base) var(--ease-in-out);
    overflow-y: auto;
  }

  .nav-menu[data-open='true'] {
    transform: translateX(0);
  }

  .nav-link {
    display: block;
    padding: var(--space-4);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-base);
    transition: background-color var(--transition-base) var(--ease-in-out);
  }

  .nav-link:hover {
    background-color: var(--color-bg-secondary);
  }

  .nav-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .nav-link.active {
    color: var(--color-brand-primary);
    background-color: var(--color-brand-primary-light);
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    .mobile-menu-button {
      display: none;
    }

    .nav-menu {
      position: static;
      flex-direction: row;
      gap: var(--space-2);
      padding: 0;
      background-color: transparent;
      border-top: none;
      transform: none;
      overflow-y: visible;
    }

    .nav-link {
      padding: var(--space-3) var(--space-4);
      font-size: var(--font-size-base);
    }
  }
</style>

<script>
  // Navigation toggle functionality
  function initNavigation() {
    const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement;
    const menu = document.getElementById('nav-menu');
    const menuIcon = toggle?.querySelector('.menu-icon');
    const closeIcon = toggle?.querySelector('.close-icon');

    if (!toggle || !menu || !menuIcon || !closeIcon) return;

    let isOpen = false;

    function setMenuState(open: boolean) {
      isOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      menu.setAttribute('data-open', String(open));

      if (open) {
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    toggle.addEventListener('click', () => {
      setMenuState(!isOpen);
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        setMenuState(false);
        toggle.focus();
      }
    });

    // Close on route change (for Astro view transitions)
    document.addEventListener('astro:page-load', () => {
      if (isOpen) setMenuState(false);
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavigation);
  } else {
    initNavigation();
  }
</script>
