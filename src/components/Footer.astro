---
/**
 * Footer Component
 * Accessible footer with navigation and legal links
 */
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Company Info -->
      <div class="footer-section">
        <h3 class="footer-heading">Extrawurst Wetzlar</h3>
        <address class="footer-address">
          Bahnhofstraße 1<br />
          35576 Wetzlar<br />
          Deutschland
        </address>
        <p class="footer-contact">
          <a href="tel:+4964441123456">+49 6441 123456</a><br />
          <a href="mailto:info@extrawurst-wetzlar.de">info@extrawurst-wetzlar.de</a>
        </p>
      </div>

      <!-- Quick Links -->
      <div class="footer-section">
        <h3 class="footer-heading">Restaurant</h3>
        <ul class="footer-links" role="list">
          <li><a href="/speisekarte/">Speisekarte</a></li>
          <li><a href="/ueber-uns/">Über uns</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </div>

      <!-- Service -->
      <div class="footer-section">
        <h3 class="footer-heading">Service</h3>
        <ul class="footer-links" role="list">
          <li><a href="/kontakt/">Reservierung</a></li>
          <li><a href="/kontakt/">Catering</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div class="footer-section">
        <h3 class="footer-heading">Rechtliches</h3>
        <ul class="footer-links" role="list">
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} Extrawurst Wetzlar GmbH. Alle Rechte vorbehalten.
      </p>
      <p class="footer-meta">
        <span>Öffnungszeiten:</span>
        Mo-Fr 11:00-22:00 Uhr, Sa-So 12:00-23:00 Uhr
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-neutral-900);
    color: var(--color-neutral-100);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    margin-top: var(--space-24);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-heading {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-2);
  }

  .footer-address {
    font-style: normal;
    line-height: var(--line-height-relaxed);
    color: var(--color-neutral-200);
  }

  .footer-contact {
    line-height: var(--line-height-relaxed);
  }

  .footer-contact a {
    color: var(--color-neutral-200);
    text-decoration: none;
    transition: color var(--transition-base) var(--ease-in-out);
  }

  .footer-contact a:hover {
    color: var(--color-brand-primary);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .footer-links a {
    color: var(--color-neutral-200);
    text-decoration: none;
    transition: color var(--transition-base) var(--ease-in-out);
  }

  .footer-links a:hover {
    color: var(--color-brand-primary);
  }

  .footer-links a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .footer-bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-neutral-700);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .copyright,
  .footer-meta {
    font-size: var(--font-size-sm);
    color: var(--color-neutral-500);
  }

  .footer-meta span {
    font-weight: var(--font-weight-semibold);
    color: var(--color-neutral-200);
  }
</style>
